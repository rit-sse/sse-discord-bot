BOT_FEATURES=verification

# Core configuration
BOT_TOKEN=replace-with-your-bot-token
GUILD_ID=replace-with-your-server-id
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sse_discord_bot
DATABASE_MAX_CONNECTIONS=10
RUST_LOG=info

# Verification feature
VERIFIED_ROLE_ID=replace-with-your-verified-role-id
UNVERIFIED_ROLE_ID=replace-with-your-unverified-role-id
VERIFICATION_LOG_CHANNEL_ID=replace-with-your-verification-log-channel-id
VERIFICATION_ALLOWED_EMAIL_DOMAINS=rit.edu
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM_ADDRESS=bot@example.com

# Onboarding feature (requires BOT_FEATURES=verification,onboarding)
AUTHENTIK_BASE_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_USERNAME=
AUTHENTIK_PASSWORD=
AUTHENTIK_HEADSCALE_GROUP_UUID=
ONBOARDING_TARGETS="headscale|Headscale|authentik-headscale-group-uuid|role-officer;tech-platform|Tech Platform|authentik-platform-group-uuid|role-officer,role-tech-lead"
AUTHENTIK_LOGIN_URL=
HEADSCALE_LOGIN_URL=
ONBOARDING_REVIEW_CHANNEL_ID=
ONBOARDING_OFFICER_ROLE_ID=

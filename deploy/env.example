# Copy this file to deploy/.env and restrict it to the deployment operator.

BOT_FEATURES=verification
BOT_IMAGE=ghcr.io/rit-sse/sse-discord-bot:main
BOT_TOKEN=replace-with-production-discord-bot-token
GUILD_ID=replace-with-production-discord-guild-id
VERIFIED_ROLE_ID=replace-with-production-verified-role-id
VERIFICATION_LOG_CHANNEL_ID=replace-with-production-verification-log-channel-id

POSTGRES_DB=sse_discord_bot
POSTGRES_USER=sse_discord_bot
# Use a long URL-safe value so the same password can be embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-url-safe-password
DATABASE_URL=postgres://sse_discord_bot:replace-with-url-safe-password@postgres:5432/sse_discord_bot
DATABASE_MAX_CONNECTIONS=10

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=replace-with-production-smtp-username
SMTP_PASSWORD=replace-with-production-smtp-password
EMAIL_FROM_ADDRESS=bot@example.com

RUST_LOG=info
